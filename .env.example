# =============================================================================
# SuperCool Finances — environment template.
#
# HOW TO USE:  copy this file to `.env` before running `docker compose up`:
#                 cp .env.example .env
#
# `.env` is git-ignored (see .gitignore). This template (`.env.example`) is the
# ONLY env file committed. Every value here is a safe, non-secret PLACEHOLDER.
# Real secrets (DB passwords, Keycloak admin, client secrets) live only in your
# local `.env` or in Docker secrets — NEVER commit them.
#
# This file documents every ${VAR} the compose spine references today, plus the
# reserved host-port map (the macro contract) that later steps wire up.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (step 0 — referenced by docker-compose.yml today)
# Source of truth: ledger + outbox. Postgres requires a password to boot.
# In step 1 (spec 01) this same instance also gains the `keycloak` database and
# least-privilege roles — not configured here.
# -----------------------------------------------------------------------------
POSTGRES_USER=supercool
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=balance

# -----------------------------------------------------------------------------
# Reserved host-port map (macro contract — spec 00 §3)
# Only the edges (and Keycloak's browser URL) are ever host-published. These are
# declared now so the contract is fixed; each is wired to its service later:
# -----------------------------------------------------------------------------
# public-nginx: Client SPA, OTP SPA, /api          — wired in step 4 (spec 06)
PUBLIC_HTTP_PORT=8080
# internal-nginx: Admin SPA, /admin (demo-only)     — wired in step 4 (spec 06)
INTERNAL_HTTP_PORT=8081
# keycloak: login UI + OIDC/JWKS/introspection      — wired in step 2 (spec 02)
KEYCLOAK_PORT=8082
