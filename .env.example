# =============================================================================
# SuperCool Finances — environment template.
#
# HOW TO USE:  copy this file to `.env` before running `docker compose up`:
#                 cp .env.example .env
#
# `.env` is git-ignored (see .gitignore). This template (`.env.example`) is the
# ONLY env file committed. Every value here is a safe, non-secret PLACEHOLDER.
# Real secrets (DB passwords, Keycloak admin, client secrets) live only in your
# local `.env` or in Docker secrets — NEVER commit them.
#
# This file documents every ${VAR} the compose spine references today, plus the
# reserved host-port map (the macro contract) that later steps wire up.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (spec 01) — source of truth: ledger + outbox, plus Keycloak's store.
#
# The BOOTSTRAP SUPERUSER below is used only to boot the server and run the init
# script (infra/postgres/init) on first start; services NEVER connect as it.
# On first boot the init script creates two logical databases (`balance`,
# `keycloak`), two least-privilege login roles, and revokes CONNECT from PUBLIC
# so each role can reach ONLY its own database (database-per-service by privilege).
# -----------------------------------------------------------------------------
POSTGRES_USER=supercool
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_PASSWORD=changeme-superuser-local
POSTGRES_DB=balance

# Balance app role — owns the `balance` DB; cannot connect to `keycloak`.
POSTGRES_BALANCE_USER=balance_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_BALANCE_PASSWORD=changeme-balance-local
# Keycloak role — owns the `keycloak` DB; cannot connect to `balance`.
POSTGRES_KEYCLOAK_USER=keycloak_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_KEYCLOAK_PASSWORD=changeme-keycloak-local

# -----------------------------------------------------------------------------
# Redis (spec 01) — OTP codes + Redis Streams transport. AUTH + AOF enabled.
# The password is injected into `--requirepass` by compose and exported to the
# healthcheck via REDISCLI_AUTH; it is never written to a committed file.
# Key-space convention (owned by the balance service later): `otp:<txId>` for
# transaction codes (TTL-managed) and the stream key `events:transactions`.
# -----------------------------------------------------------------------------
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
REDIS_PASSWORD=changeme-redis-local

# -----------------------------------------------------------------------------
# MongoDB (spec 01) — analytics read model (analytics-owned). Auth enabled.
# The root user boots the server and runs the init script; the app user is scoped
# to readWrite on `analytics` only.
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongoroot
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
MONGO_INITDB_ROOT_PASSWORD=changeme-mongoroot-local
MONGO_DB=analytics
MONGO_APP_USER=analytics_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
MONGO_APP_PASSWORD=changeme-mongoapp-local

# -----------------------------------------------------------------------------
# Connection-string contracts (spec 01 § Contracts) — the CONTRACT OF RECORD.
# No service consumes these yet; consumers arrive in steps 2-3. Each is a fully
# formed string (compose env files do not self-expand), so keep it consistent
# with the credentials above if you change a placeholder. Every reference uses
# the in-network service name (postgres/redis/mongo), never a host port.
# -----------------------------------------------------------------------------
# Balance app role -> `balance` DB (NestJS/TypeORM DSN).
POSTGRES_URL=postgresql://balance_app:changeme-balance-local@postgres:5432/balance
# Keycloak role -> `keycloak` DB (JDBC URL; Keycloak reads creds from
# POSTGRES_KEYCLOAK_USER/PASSWORD separately, so none are embedded here).
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
# Balance service -> Redis (default user authenticated by requirepass).
REDIS_URL=redis://default:changeme-redis-local@redis:6379
# Analytics app user -> `analytics` DB (authSource is the app user's own DB).
MONGO_URL=mongodb://analytics_app:changeme-mongoapp-local@mongo:27017/analytics?authSource=analytics

# -----------------------------------------------------------------------------
# Reserved host-port map (macro contract — spec 00 §3)
# Only the edges (and Keycloak's browser URL) are ever host-published. These are
# declared now so the contract is fixed; each is wired to its service later:
# -----------------------------------------------------------------------------
# public-nginx: Client SPA, OTP SPA, /api          — wired in step 4 (spec 06)
PUBLIC_HTTP_PORT=8080
# internal-nginx: Admin SPA, /admin (demo-only)     — wired in step 4 (spec 06)
INTERNAL_HTTP_PORT=8081
# keycloak: login UI + OIDC/JWKS/introspection      — wired in step 2 (spec 02)
KEYCLOAK_PORT=8082
