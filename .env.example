# =============================================================================
# SuperCool Finances — environment template.
#
# HOW TO USE:  copy this file to `.env` before running `docker compose up`:
#                 cp .env.example .env
#
# `.env` is git-ignored (see .gitignore). This template (`.env.example`) is the
# ONLY env file committed. Every value here is a safe, non-secret PLACEHOLDER.
# Real secrets (DB passwords, Keycloak admin, client secrets) live only in your
# local `.env` or in Docker secrets — NEVER commit them.
#
# This file documents every ${VAR} the compose spine references today, plus the
# reserved host-port map (the macro contract) that later steps wire up.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (spec 01) — source of truth: ledger + outbox, plus Keycloak's store.
#
# The BOOTSTRAP SUPERUSER below is used only to boot the server and run the init
# script (infra/postgres/init) on first start; services NEVER connect as it.
# On first boot the init script creates two logical databases (`balance`,
# `keycloak`), two least-privilege login roles, and revokes CONNECT from PUBLIC
# so each role can reach ONLY its own database (database-per-service by privilege).
# -----------------------------------------------------------------------------
POSTGRES_USER=supercool
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_PASSWORD=changeme-superuser-local
POSTGRES_DB=balance

# Balance app role — owns the `balance` DB; cannot connect to `keycloak`.
POSTGRES_BALANCE_USER=balance_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_BALANCE_PASSWORD=changeme-balance-local
# Keycloak role — owns the `keycloak` DB; cannot connect to `balance`.
POSTGRES_KEYCLOAK_USER=keycloak_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
POSTGRES_KEYCLOAK_PASSWORD=changeme-keycloak-local

# -----------------------------------------------------------------------------
# Redis (spec 01) — OTP codes + Redis Streams transport. AUTH + AOF enabled.
# The password is injected into `--requirepass` by compose and exported to the
# healthcheck via REDISCLI_AUTH; it is never written to a committed file.
# Key-space convention (owned by the balance service later): `otp:<txId>` for
# transaction codes (TTL-managed) and the stream key `events:transactions`.
# -----------------------------------------------------------------------------
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
REDIS_PASSWORD=changeme-redis-local

# -----------------------------------------------------------------------------
# MongoDB (spec 01) — analytics read model (analytics-owned). Auth enabled.
# The root user boots the server and runs the init script; the app user is scoped
# to readWrite on `analytics` only.
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongoroot
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
MONGO_INITDB_ROOT_PASSWORD=changeme-mongoroot-local
MONGO_DB=analytics
MONGO_APP_USER=analytics_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
MONGO_APP_PASSWORD=changeme-mongoapp-local

# -----------------------------------------------------------------------------
# Keycloak (spec 02) — identity provider. Boots `start --import-realm`, importing
# the `supercool` realm from tools/keycloak/realm-export.json, and stores its
# state in the `keycloak` Postgres DB via the POSTGRES_KEYCLOAK_* creds above
# (discrete creds — no JDBC-URL var, per spec 01 § Contracts).
#
# KC_HOSTNAME is the SHARED host alias that makes the token `issuer` identical for
# the browser and for in-container callers (spec 02, the load-bearing detail):
#   - Browser: *.localtest.me resolves to 127.0.0.1 (public DNS), and Keycloak is
#     published on KEYCLOAK_PORT below.
#   - Containers: a compose network alias (docker-compose.yml) maps this same name
#     to the keycloak container on app-public/app-internal.
# This var is the BARE host alias. Compose derives the container's own KC_HOSTNAME
# (the full URL http://${KC_HOSTNAME}:${KEYCLOAK_PORT}) from it — same name, fuller
# form — giving the issuer http://${KC_HOSTNAME}:${KEYCLOAK_PORT}/realms/supercool
# with the port matching on both sides. Do not point this at `localhost`.
#
# NOTE (spec 06): public-kong validates tokens against the issuer derived from
# these two vars — http://${KC_HOSTNAME}:${KEYCLOAK_PORT}/realms/supercool. Kong's
# DB-less declarative config cannot interpolate env vars, so that issuer is written
# LITERALLY as the `ISSUER` constant in the pre-function in infra/kong-public/kong.yml.
# If you change KC_HOSTNAME or KEYCLOAK_PORT here, update that constant too, or the
# gateway will reject all tokens.
# -----------------------------------------------------------------------------
KC_HOSTNAME=keycloak.localtest.me

# Master-realm bootstrap admin (temporary admin account created on first boot).
# Used to reach the admin console / REST API; NOT part of the realm export.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-kcadmin-local

# -----------------------------------------------------------------------------
# Balance service (spec 03) — NestJS foundation. Under compose the DISCRETE creds
# above (POSTGRES_BALANCE_*, REDIS_PASSWORD) are mapped into the service's OWN env
# var names (DB_*, REDIS_*); the service composes its own DSN/URL internally. The
# service-identity shared secret for the `/internal` guard (defense in depth behind
# the network isolation, ADR-12) plus the money-domain secrets (below) are the
# app-owned secrets the service requires at boot:
# -----------------------------------------------------------------------------
# PLACEHOLDER ONLY — local demo token. Never a real secret; override in .env.
# Shared between the balance service and any peer that calls its `/internal/*`
# endpoints (mocked external rails in spec 04). NOT a user JWT.
INTERNAL_SERVICE_TOKEN=changeme-internal-token-local

# Money-domain secrets the balance service REQUIRES at boot (spec 04 steps 4a/5c;
# its zod env schema fails fast without them). Both are distinct trust domains and
# must be at least 16 characters.
# PLACEHOLDER ONLY — local demo pepper. Never a real secret; override in .env.
# Keyed HMAC pepper for hashing OTP codes at rest (never stored plaintext).
OTP_HASH_SECRET=changeme-otp-hash-pepper-local
# PLACEHOLDER ONLY — local demo secret. Never a real secret; override in .env.
# HMAC signing secret for the external-rail webhooks on the `/external` surface.
RAILS_WEBHOOK_SIGNING_SECRET=changeme-rails-webhook-secret-local

# -----------------------------------------------------------------------------
# Connection strings are intentionally NOT defined here. Each service composes its
# own DSN at its own step (steps 2-3) from the discrete credentials above plus its
# store's in-network coordinates — service name (postgres/redis/mongo), default
# port, and its own database name. This keeps every credential in ONE place and
# leaves the URL format to the consumer's driver (TypeORM DSN, JDBC URL, redis://,
# mongodb://). (Compose env_file does not interpolate, so a URL built from other
# vars could not be expressed here anyway.) See spec 01 § Contracts.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Reserved host-port map (macro contract — spec 00 §3)
# Only the edges (and Keycloak's browser URL) are ever host-published. These are
# declared now so the contract is fixed; each is wired to its service later:
# -----------------------------------------------------------------------------
# public-nginx: Client SPA, OTP SPA, /api          — WIRED in step 4 (spec 06,
#   public edge). Host-published :8080 -> :80; reverse-proxies /api -> public-kong.
PUBLIC_HTTP_PORT=8080
# internal-nginx: Admin SPA, /admin (demo-only)     — wired in step 4 (spec 06)
INTERNAL_HTTP_PORT=8081
# keycloak: login UI + OIDC/JWKS/introspection      — WIRED in step 2 (spec 02).
# Doubles as Keycloak's internal HTTP port (KC_HTTP_PORT) so the issuer's port is
# identical from the browser and from containers.
KEYCLOAK_PORT=8082
