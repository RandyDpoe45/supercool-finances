# =============================================================================
# admin-app (web/admin) — Vite build-time env. Copy to `.env.local` to override
# locally. All keys are PUBLIC by design: they ship in the browser bundle. NEVER
# put a secret here — the OIDC client is a PUBLIC client (Authorization Code +
# PKCE, no client secret).
#
# This is the admin dashboard SPA, ROOT-served on its own dedicated internal
# origin (:8081). Its served + dev origin is `http://localhost:8081/`, which
# matches the Keycloak `admin-app` client's allowlisted `http://localhost:8081/*`
# (see tools/keycloak/realm-export.json).
# =============================================================================

# Same-origin, service-namespaced API base (ADR-17). This is the internal path the
# transport (nginx -> Kong) exposes; Kong strips the `/balance` segment so the
# balance-service still receives its own `/admin` surface. Keep it relative so calls go
# through the app's own origin (MSW mirrors `/balance/admin` in dev/test). Do NOT
# hardcode an absolute backend URL here.
#
VITE_API_BASE_URL=/balance/admin

# Same-origin, service-namespaced base for the SECOND backend surface: the analytics server's
# reporting reads (ADR-17). The internal transport strips the `/analytics` segment so the analytics
# server still receives its own `/admin` surface; the analytics dashboard's own RTK Query slice
# calls it with the SAME OIDC bearer. Keep it relative (MSW mirrors `/analytics/admin` in dev/test);
# do NOT hardcode an absolute backend URL here.
VITE_ANALYTICS_API_BASE_URL=/analytics/admin

# Keycloak OIDC realm issuer. Must match the token `issuer` exactly; the browser
# reaches this host via *.localtest.me -> 127.0.0.1 and the published :8082.
VITE_OIDC_AUTHORITY=http://keycloak.localtest.me:8082/realms/supercool

# Public Keycloak client id for THIS SPA — the admin dashboard login.
# See tools/keycloak/realm-export.json.
VITE_OIDC_CLIENT_ID=admin-app

# Set to "false" to disable the in-browser MSW stub during `npm run dev`. Mocks are
# dev-only regardless (never started in a production build).
VITE_ENABLE_API_MOCKS=true
