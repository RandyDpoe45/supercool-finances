# =============================================================================
# client-app (web/client) — Vite build-time env. Copy to `.env.local` to override
# locally. All keys are PUBLIC by design: they ship in the browser bundle. NEVER
# put a secret here — the OIDC client is a PUBLIC client (Authorization Code +
# PKCE, no client secret).
# =============================================================================

# Same-origin API base. Kept as `/api` so calls go through the app's own nginx
# origin (MSW intercepts `/api` in dev/test until the real transport lands in a
# later step). Do NOT hardcode an absolute backend URL here.
VITE_API_BASE_URL=/api

# Keycloak OIDC realm issuer. Must match the token `issuer` exactly; the browser
# reaches this host via *.localtest.me -> 127.0.0.1 and the published :8082.
VITE_OIDC_AUTHORITY=http://keycloak.localtest.me:8082/realms/supercool

# Public Keycloak client id for this SPA (see tools/keycloak/realm-export.json).
VITE_OIDC_CLIENT_ID=client-app

# Set to "false" to disable the in-browser MSW stub during `npm run dev`. Mocks are
# dev-only regardless (never started in a production build).
VITE_ENABLE_API_MOCKS=true
