# =============================================================================
# analytics-server — hardened supply-chain posture (spec 03 coordination contract).
# =============================================================================
# Pin the exact resolved version on every install (no floating ^/~ ranges).
save-exact=true
# Always maintain a package-lock.json; `npm ci` installs strictly from it.
package-lock=true
# Do NOT silently relax peer-dependency resolution — surface real conflicts.
legacy-peer-deps=false
# Enforce the package.json "engines" (node >=24) at install time.
engine-strict=true
# Never run dependency lifecycle scripts (supply-chain: no arbitrary postinstall).
ignore-scripts=true
# Minimum release age = 7 days (10080 minutes). Fresh releases are not adopted.
#
# NOTE: current npm (11.x) does not natively enforce this key — it treats it as an
# unknown config and only WARNS. It is set here to (a) declare intent and (b) be
# honored automatically once npm/an installer supports it. Until then the policy is
# upheld by pinning EXACT, mature versions (all comfortably older than 7 days) in
# package.json. See docs/README.md ("Supply-chain posture").
minimum-release-age=10080
