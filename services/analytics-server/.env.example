# =============================================================================
# analytics-server — OWN env contract (spec 03).
#
# This service is a self-contained component (ADR-16): it defines its OWN env var
# names. Under docker-compose the root discrete credentials are MAPPED into these
# names (see the repo-root docker-compose.yml). For a STANDALONE local run, copy
# this file to `.env` and run with Node's native loader (the service also calls
# process.loadEnvFile() on boot):  node --env-file=.env dist/main.js
#
# Every value below is a safe, non-secret PLACEHOLDER. Real secrets live only in a
# git-ignored `.env` or in Docker secrets — NEVER commit them.
#
# The service composes its OWN MongoDB DSN and Redis URL from these DISCRETE
# parts at boot (validated by zod). It NEVER reads a pre-assembled `*_URL` string.
# =============================================================================

# development | test | production
NODE_ENV=development
# HTTP port the service listens on (in-network only; not host-published).
PORT=3000

# --- MongoDB (the `analytics` DB; the least-privilege analytics app user) -----
# The read model this service owns. `MONGO_AUTH_SOURCE` is the DB the app user
# authenticates against (the app user is created in the `analytics` DB).
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=analytics
MONGO_USER=analytics_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
MONGO_PASSWORD=changeme-mongoapp-local
MONGO_AUTH_SOURCE=analytics

# --- Redis (the `events:transactions` stream consumer — spec 05) -------------
# The transaction-event stream this service consumes into the read model. The
# service composes `redis://:<password>@<host>:<port>` from these discrete parts.
REDIS_HOST=redis
REDIS_PORT=6379
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
REDIS_PASSWORD=changeme-redis-local

# --- Service identity (the `/internal` service-token guard) ------------------
# PLACEHOLDER ONLY — local demo token. Never a real secret; override in .env.
INTERNAL_SERVICE_TOKEN=changeme-internal-token-local
