# =============================================================================
# balance-service — OWN env contract (spec 03).
#
# This service is a self-contained component (ADR-16): it defines its OWN env var
# names. Under docker-compose the root discrete credentials are MAPPED into these
# names (see the repo-root docker-compose.yml). For a STANDALONE local run, copy
# this file to `.env` and run with Node's native loader (the service also calls
# process.loadEnvFile() on boot):  node --env-file=.env dist/main.js
#
# Every value below is a safe, non-secret PLACEHOLDER. Real secrets live only in a
# git-ignored `.env` or in Docker secrets — NEVER commit them.
#
# The service composes its OWN Postgres DSN and Redis URL from these DISCRETE parts
# at boot (validated by zod). It NEVER reads a pre-assembled `*_URL` string.
# =============================================================================

# development | test | production
NODE_ENV=development
# HTTP port the service listens on (in-network only; not host-published).
PORT=3000

# --- Postgres (the `balance` DB; the balance app role) -----------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=balance
DB_USER=balance_app
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
DB_PASSWORD=changeme-balance-local

# --- Redis (OTP + stream transport; used from spec 04 onward) ----------------
REDIS_HOST=redis
REDIS_PORT=6379
# PLACEHOLDER ONLY — local demo password. Never a real secret; override in .env.
REDIS_PASSWORD=changeme-redis-local

# --- Service identity (the `/internal` service-token guard) ------------------
# PLACEHOLDER ONLY — local demo token. Never a real secret; override in .env.
INTERNAL_SERVICE_TOKEN=changeme-internal-token-local

# --- OTP hashing (pepper for the keyed HMAC that hashes OTP codes at rest) ---
# The plaintext code is delivered out-of-band and NEVER stored; Redis holds only
# its keyed hash. PLACEHOLDER ONLY (min 16 chars) — never a real secret; override in .env.
OTP_HASH_SECRET=change-me-local-otp-hash-secret-min-16-chars

# --- External payees (cooling-off window before a new payee is usable) -------
# Seconds after enrollment before a payee becomes a valid destination
# (`now() >= cooling_off_until`). The anti-fraud delay; default 24h (86400).
PAYEE_COOLING_OFF_SECONDS=86400
